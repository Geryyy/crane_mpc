<?xml version="1.0"?>
<package format="3">
  <name>crane_mpc</name>
  <version>0.1.0</version>
  <description>The acados RTI MPC node: it solves the
    crane_model OCP and publishes `/crane/mpc/horizon` at 25 Hz.</description>
  <maintainer email="maintainers@example.invalid">Architecture maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

    <depend>crane_model</depend>
    <depend>crane_msgs</depend>
  <depend>crane_ocp</depend>
    <depend>sensor_msgs</depend>
    <depend>control_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>nav_msgs</depend>
    <depend>acados</depend>
  <!-- The node builds the OCP through acados_template at startup, so both
       are runtime dependencies of the Python half. The C++ half links
       neither: what reaches it is generated straight-line C. -->
  <depend>casadi</depend>
  <build_depend>eigen</build_depend>
  <exec_depend>eigen</exec_depend>
  <depend>generate_parameter_library</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <exec_depend>python3-numpy</exec_depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>


  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
