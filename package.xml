<?xml version="1.0"?>
<package format="3">
  <name>crane_mpc</name>
  <version>0.1.0</version>
  <description>The acados RTI MPC node: it solves the
    crane_model OCP and publishes `/crane/mpc/horizon` at 25 Hz.</description>
  <maintainer email="maintainers@example.invalid">Architecture maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

    <depend>crane_model</depend>
    <depend>crane_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>control_msgs</depend>
  <depend>action_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>nav_msgs</depend>
    <depend>acados</depend>
  <!-- The node builds the OCP through acados_template at startup, so both are
       runtime dependencies. Neither has a rosdep key here; the image provides
       them. -->
  <depend>casadi</depend>
  <depend>generate_parameter_library</depend>
  <depend>rclpy</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- launch only: the node itself imports neither. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>


  <test_depend>python3-pytest</test_depend>
  <!-- `test_launch_contract.py` parses the shipped config yaml. -->
  <test_depend>python3-yaml</test_depend>
  <!-- `crane_mpc/solver.py` opens the exported solver through
       `crane_ocp_export`, so this is a runtime dependency now, not the
       test-only source-tree import it was: the module moved out of
       `crane_ocp/scripts/` and is installed. Nothing links the C++ capsule any
       more; issue 132 deleted the one target that did. -->
  <exec_depend>crane_ocp</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
